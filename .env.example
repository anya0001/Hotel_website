# Copy this file to .env and fill in real values for production.
# Flask automatically loads .env if python-dotenv is installed and FLASK_APP is set.

FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-long-random-string

# Optional: choose the password used by demo accounts created by `flask seed-db`.
# Leave blank to generate a random password and print it once in the terminal.
DEMO_PASSWORD=

# Leave unset to use local SQLite in development.
DEV_DATABASE_URL=sqlite:///instance/hotel_dev.sqlite

# Set on Render / production (Render provides DATABASE_URL automatically for its Postgres add-on).
DATABASE_URL=

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@luxstay-hotel.com
# Set to 0 once real SMTP credentials are configured.
MAIL_SUPPRESS_SEND=1
