# Copy this file to .env and fill in real values for your deployment.

FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-long-random-string

# Optional: choose the password used by demo accounts created by `flask seed-db`.
# Leave blank to generate a random password and print it once in the terminal.
DEMO_PASSWORD=

# Development database. Leave as-is for local SQLite.
DEV_DATABASE_URL=sqlite:///instance/hotel_dev.sqlite

# Production database. Required when FLASK_CONFIG=production.
# Render/Postgres providers usually supply this automatically.
DATABASE_URL=

# Mail settings. Sending is disabled by default for local development.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com
MAIL_SUPPRESS_SEND=1

# Hotel identity and contact details. Change these for your own/client deployment.
HOTEL_NAME=LuxStay Hotel & Resort
HOTEL_PHONE=+1 (555) 019-2842
HOTEL_EMAIL=reservations@luxstay-hotel.com
HOTEL_ADDRESS=18 Marina Boulevard, Coral Bay
HOTEL_LAT=25.0805
HOTEL_LNG=55.1403
